# ==============================================================================
# MAST Topology Lab - Heterogeneous Multi-Agent LLM Configuration
# 6 Agents: 5 Cloud LLMs via https://aicredits.in/v1 + 1 Local Ollama
# ==============================================================================

# Global Runtime & Simulation Control
# Set to 'false' to enable live completions. If 'true', offline persona simulation is used.
USE_MOCK_LLM=false
MAX_AGENT_TURNS=10
DATABASE_URL=sqlite:///./mast_lab.db
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ==============================================================================
# Shared Cloud API Key for https://aicredits.in/v1
# (Paste your API key here once to power all 5 cloud models!)
# ==============================================================================
AICREDITS_API_KEY=YOUR_API_KEY
AICREDITS_BASE_URL=https://aicredits.in/v1

# ==============================================================================
# AGENT 1: Coordinator (Cloud Model 1)
# ==============================================================================
AGENT_1_PROVIDER=aicredits
AGENT_1_MODEL=deepseek/deepseek-v3.2
AGENT_1_API_KEY=
AGENT_1_BASE_URL=https://aicredits.in/v1
AGENT_1_TEMPERATURE=0.7

# ==============================================================================
# AGENT 2: Solver (Cloud Model 2)
# ==============================================================================
AGENT_2_PROVIDER=aicredits
AGENT_2_MODEL=openai/gpt-oss-120b
AGENT_2_API_KEY=
AGENT_2_BASE_URL=https://aicredits.in/v1
AGENT_2_TEMPERATURE=0.7

# ==============================================================================
# AGENT 3: Critic (Cloud Model 3)
# ==============================================================================
AGENT_3_PROVIDER=aicredits
AGENT_3_MODEL=qwen/qwen3-30b-a3b-instruct-2507
AGENT_3_API_KEY=
AGENT_3_BASE_URL=https://aicredits.in/v1
AGENT_3_TEMPERATURE=0.7

# ==============================================================================
# AGENT 4: Fact Checker (Cloud Model 4)
# ==============================================================================
AGENT_4_PROVIDER=aicredits
AGENT_4_MODEL=google/gemini-2.0-flash-lite-001
AGENT_4_API_KEY=
AGENT_4_BASE_URL=https://aicredits.in/v1
AGENT_4_TEMPERATURE=0.7

# ==============================================================================
# AGENT 5: Alternative Solver (Cloud Model 5)
# ==============================================================================
AGENT_5_PROVIDER=aicredits
AGENT_5_MODEL=nex-agi/nex-n2-mini
AGENT_5_API_KEY=
AGENT_5_BASE_URL=https://aicredits.in/v1
AGENT_5_TEMPERATURE=0.7

# ==============================================================================
# AGENT 6: Final Reviewer (Local Ollama Instance)
# ==============================================================================
AGENT_6_PROVIDER=ollama
AGENT_6_MODEL=llama3:8b
AGENT_6_API_KEY=ollama
AGENT_6_BASE_URL=http://localhost:11434/v1
AGENT_6_TEMPERATURE=0.7
