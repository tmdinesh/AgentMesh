# ==============================================================================
# AgentMesh — Demo Environment Configuration (.env.demo.example)
# Used by docker-compose.demo.yml and demo launchers (demo.bat / demo.sh).
# Copy this file to backend/.env.demo if customizing local parameters.
# ==============================================================================

# Cloud API Key (Optional — used for cloud model fallback escalation)
AICREDITS_API_KEY=YOUR_AICREDITS_API_KEY_HERE
AICREDITS_BASE_URL=https://aicredits.in/v1

# Runtime Configuration
USE_MOCK_LLM=false
MAX_AGENT_TURNS=10
DATABASE_URL=sqlite:////data/mast_lab.db
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173,http://127.0.0.1:5173

# Apache Kafka Configuration
# Set USE_REAL_KAFKA=true when connecting to live cluster; false uses InMemory broker
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
USE_REAL_KAFKA=false

# Agent 1 — Supervisor (Ollama: ollama-a container)
AGENT_1_PROVIDER=ollama
AGENT_1_MODEL=llama3:8b
AGENT_1_BASE_URL=http://ollama-a:11434/v1
AGENT_1_API_KEY=ollama
AGENT_1_TEMPERATURE=0.7

# Agent 2 — Specialist: Coding (Ollama: ollama-b container)
AGENT_2_PROVIDER=ollama
AGENT_2_MODEL=mistral:7b
AGENT_2_BASE_URL=http://ollama-b:11434/v1
AGENT_2_API_KEY=ollama
AGENT_2_TEMPERATURE=0.7

# Agent 3 — Specialist: Reasoning (Ollama: ollama-b container, shared)
AGENT_3_PROVIDER=ollama
AGENT_3_MODEL=mistral:7b
AGENT_3_BASE_URL=http://ollama-b:11434/v1
AGENT_3_API_KEY=ollama
AGENT_3_TEMPERATURE=0.7

# Agent 4 — Fact Checker (Ollama: ollama-c container)
AGENT_4_PROVIDER=ollama
AGENT_4_MODEL=phi3:medium
AGENT_4_BASE_URL=http://ollama-c:11434/v1
AGENT_4_API_KEY=ollama
AGENT_4_TEMPERATURE=0.7

# Agent 5 — Alternative Solver (Ollama: ollama-c container)
AGENT_5_PROVIDER=ollama
AGENT_5_MODEL=phi3:medium
AGENT_5_BASE_URL=http://ollama-c:11434/v1
AGENT_5_API_KEY=ollama
AGENT_5_TEMPERATURE=0.7

# Agent 6 — Final Reviewer (Ollama: ollama-a container)
AGENT_6_PROVIDER=ollama
AGENT_6_MODEL=llama3:8b
AGENT_6_BASE_URL=http://ollama-a:11434/v1
AGENT_6_API_KEY=ollama
AGENT_6_TEMPERATURE=0.7
